# Control-plane server (server.cjs)
PORT=3002

# Upstream services — LOCAL DEVELOPMENT defaults.
# For the Render deployment these are set in render.yaml / the Render dashboard:
#   BACKEND_URL=https://cscm-backend.onrender.com
#   GATEWAY_URL=https://cscm-gateway.onrender.com
#   AI_ML_URL=https://cscm-aiml.onrender.com
BACKEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8080
AI_ML_URL=http://localhost:8000

# Dashboard login (required in any shared environment)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123
# Required unless NODE_ENV=development — the server refuses to boot in prod without it
DASHBOARD_JWT_SECRET=

# Required on Render (cscm-dashboard): the SAME value as the backend's JWT_SECRET,
# so the dashboard can sign short-lived admin tokens for the backend debug API.
# Without it, admin pages (DB explorer, simulation, agents) return 401.
BACKEND_JWT_SECRET=

# Required on Render (cscm-dashboard): the SAME value as the AI/ML service's
# AI_ML_API_KEY, forwarded as X-API-Key on AI/ML proxy calls (playground, KG, etc.)
AI_ML_API_KEY=
