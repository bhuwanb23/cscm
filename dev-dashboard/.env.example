# Control-plane server (server.cjs)
PORT=3002

# Upstream services
BACKEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8080
AI_ML_URL=http://localhost:8000

# Dashboard login (required in any shared environment)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123
# Required unless NODE_ENV=development — the server refuses to boot in prod without it
DASHBOARD_JWT_SECRET=

# Optional: lets the dashboard sign short-lived backend admin tokens so you
# don't need to paste an admin JWT in Settings. Use the SAME value as the
# backend's JWT_SECRET.
BACKEND_JWT_SECRET=

# Optional: forwarded as X-API-Key on AI/ML proxy calls
AI_ML_API_KEY=
