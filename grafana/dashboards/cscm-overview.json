{
  "uid": "cscm-overview",
  "title": "CSCM System Overview",
  "description": "End-to-end health of the CSCM platform: backend API, gateway, and AI/ML service. Data source: Prometheus (scrapes /metrics on each service).",
  "tags": ["cscm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by service (req/s)",
      "description": "Throughput across backend, gateway and AI/ML services.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "{{job}} backend" },
        { "refId": "B", "expr": "sum by (job) (rate(gateway_http_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "{{job}} gateway" },
        { "refId": "C", "expr": "sum by (job) (rate(cscm_ai_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "{{job}} ai-ml" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (%)",
      "description": "Share of responses with 4xx/5xx status across services.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "100 * sum by (job) (rate(http_requests_total{job=~\"$job\", status_code=~\"[45]..\"}[5m])) / clamp_min(sum by (job) (rate(http_requests_total{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} backend" },
        { "refId": "B", "expr": "100 * sum by (job) (rate(gateway_http_errors_total{job=~\"$job\"}[5m])) / clamp_min(sum by (job) (rate(gateway_http_requests_total{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} gateway" },
        { "refId": "C", "expr": "100 * sum by (job) (rate(cscm_ai_errors_total{job=~\"$job\"}[5m])) / clamp_min(sum by (job) (rate(cscm_ai_requests_total{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} ai-ml" }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency by service",
      "description": "95th percentile request duration.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{job}} backend" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(gateway_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{job}} gateway" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(cscm_ai_request_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "{{job}} ai-ml" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mean latency by service",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_request_duration_seconds_sum{job=~\"$job\"}[5m])) / clamp_min(sum by (job) (rate(http_request_duration_seconds_count{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} backend" },
        { "refId": "B", "expr": "sum by (job) (rate(gateway_http_request_duration_seconds_sum{job=~\"$job\"}[5m])) / clamp_min(sum by (job) (rate(gateway_http_request_duration_seconds_count{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} gateway" },
        { "refId": "C", "expr": "sum by (job) (rate(cscm_ai_request_duration_seconds_sum{job=~\"$job\"}[5m])) / clamp_min(sum by (job) (rate(cscm_ai_request_duration_seconds_count{job=~\"$job\"}[5m])), 0.001)", "legendFormat": "{{job}} ai-ml" }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process CPU time (seconds/s)",
      "description": "Approaches 1.0 when a core is saturated.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[5m])", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active connections",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "active_connections{job=~\"$job\"}", "legendFormat": "{{job}} backend" },
        { "refId": "B", "expr": "gateway_active_connections{job=~\"$job\"}", "legendFormat": "{{job}} gateway" },
        { "refId": "C", "expr": "cscm_ai_inflight_requests{job=~\"$job\"}", "legendFormat": "{{job}} ai-ml" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Node.js event loop lag (s)",
      "description": "High values mean the Node process is saturated.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "nodejs_eventloop_lag_seconds{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Gateway health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Circuit breaker state",
      "description": "0 = closed (ok), 1 = open (failing), 2 = half-open (probing).",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" }, "1": { "text": "OPEN", "color": "red" }, "2": { "text": "half-open", "color": "orange" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "gateway_circuit_breaker_state{job=~\"$job\"}", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Prometheus reachability of each service (1 = up).",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "up", "color": "green" } } } ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "up{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
