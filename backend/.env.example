# Environment variables for CSCM Backend

# Server configuration
PORT=3000
HOST=localhost
GATEWAY_PORT=8080
NODE_ENV=development

# Database Configuration
# For local development: Use SQLite (default, no DATABASE_TYPE needed)
# For Render deployment: Set DATABASE_TYPE=postgresql
# IMPORTANT: For Render deployment, set DATABASE_URL in the Render dashboard (not in this file)
# This keeps credentials secure since the repository is public
DATABASE_TYPE=sqlite
DATABASE_URL=

# PostgreSQL (for Render deployment)
# DATABASE_URL should be set in Render dashboard, not in this file
# Format: postgres://user:password@host:port/database
# Example: postgres://cscm_user:password@db.example.com:5432/cscm
# SECURITY: Never commit actual database credentials to a public repository

# Redis (for pub/sub messaging between services)
# For local development: REDIS_URL=redis://localhost:6379
# For Render deployment: REDIS_URL will be automatically set by Render from Redis Key Value
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (optional — for event streaming)
# SKIPPED on Render free tier (not available)
# Set KAFKA_BROKERS to enable if running locally with Kafka
KAFKA_BROKERS=
KAFKA_CLIENT_ID=cscm-backend

# MQTT (optional — for IoT messaging)
# SKIPPED on Render free tier (not available)
# Set MQTT_URL to enable if running locally with MQTT broker
MQTT_URL=

# Authentication
# SECURITY: in production JWT_SECRET is REQUIRED (backend fails fast without it).
# Generate with: openssl rand -hex 32
# The gateway must be given the SAME value to validate tokens.
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=24h

# API Documentation (production defaults to disabled)
# Set ENABLE_API_DOCS=true to expose /api-docs (backend) or /docs, /redoc (AI/ML)
ENABLE_API_DOCS=

# Python AI/ML API
# For local development: http://localhost:8000
# For Render deployment: <AI_ML_URL> (public) or http://cscm-aiml:8000 (internal)
AI_ML_API_URL=http://localhost:8000
AI_ML_API_TIMEOUT_MS=30000
AI_ML_API_KEY=

# Backend API URL (for Gateway)
# For local development: http://localhost:3000
# For Render deployment: http://cscm-backend:3000 (internal network)
BACKEND_URL=

# Logging
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Debug mode (set to true for development debugging)
DEBUG=false